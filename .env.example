REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
DATA_TTL_SECONDS=604800
UPLOAD_TTL_SECONDS=604800
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10
# LLM provider: gemini | openai. LLM_MODEL empty = provider default
# (gemini: gemini-3.1-flash-lite, openai: gpt-5-mini). Set only the selected provider's key.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4
SUMMARY_MAX_INPUT_CHARS=100000
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3
CLAIM_IDLE_MS=60000
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_DURATION_SECONDS=600
LOG_LEVEL=INFO
# Host ports published by docker compose (change if 8000/3000 are already in use)
API_PORT=8000
FRONTEND_PORT=3000
